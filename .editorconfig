root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

# Shell
[*.{cmd,bat,ps1}]
end_of_line = crlf

# [*.{sh,bash,zsh}]
# indent_style = space
# indent_size = 2

# Markdown
[*.{md,mdx}]
trim_trailing_whitespace = false
indent_size = unset

[Makefile]
indent_style = tab

# Java / Kotlin, PHP, Python, Rust
[*.{java,kt,kts,php,py,rs}]
# indent_style = space
indent_size = 4

# Go
[*.go]
indent_style = tab

# # Docker
# [Dockerfile*]
# indent_style = space
# indent_size = 2

# # JSON, YAML, TOML, INI
# [*.{json,jsonc,yml,yaml,toml,ini,cfg,conf}]
# indent_style = space
# indent_size = 2

# # JavaScript / TypeScript
# [*.{js,cjs,mjs,jsx,ts,tsx}]
# indent_style = space
# indent_size = 2
